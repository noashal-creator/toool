# macOS
.DS_Store
**/.DS_Store

# Claude Code workspace
.claude/

# scratch / dev-only files (underscore-prefixed)
_*

# backups
*.bak

# planning docs (keep private)
GRID-PROMPT.md
LIVE-PLAN.md

# Netlify local state
.netlify/

# function dependencies are installed by Netlify at deploy time
node_modules/

# derived from assets/chag/res/ by prep-chag-results.py — an intermediate
# step only the local review needs; res-c/ is what the card actually uses
assets/chag/res-w/

# _* above hides scratch files, but this one is Netlify's own routing table —
# without it /k (the address every card's QR encodes) 404s on the live site
!_redirects
